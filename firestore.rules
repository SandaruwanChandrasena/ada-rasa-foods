rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // The seed script creates the first admin.
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isRestaurantOwner(restaurantId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/restaurants/$(restaurantId))
        && get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerId == request.auth.uid;
    }

    function isValidRestaurant(data) {
      return data.keys().hasOnly(['name', 'cuisine', 'ownerId', 'imageUrl', 'address', 'location', 'isOpen', 'isActive', 'createdAt'])
        && data.name is string && data.name.size() > 0
        && data.cuisine is string
        && data.ownerId is string && data.ownerId.size() > 0
        && data.imageUrl is string
        && data.address is string
        && data.location is latlng
        && data.isOpen is bool
        && data.isActive is bool;
    }

    // Order fields saved at checkout (CUS-4). Stage 2 adds delivery fields.
    function isValidNewOrder(data) {
      return data.keys().hasOnly(['customerId', 'customerName', 'restaurantId', 'restaurantName', 'restaurantAddress', 'items', 'total', 'fulfillment', 'status', 'paymentMethod', 'paymentStatus', 'cardBrand', 'cardLast4', 'placedAt', 'updatedAt'])
        && data.keys().hasAll(['customerId', 'customerName', 'restaurantId', 'restaurantName', 'restaurantAddress', 'items', 'total', 'fulfillment', 'status', 'paymentMethod', 'paymentStatus', 'cardBrand', 'cardLast4', 'placedAt', 'updatedAt'])
        && data.customerId == request.auth.uid
        && data.customerName is string
        && data.restaurantId is string && data.restaurantId.size() > 0
        && data.restaurantName is string
        && data.restaurantAddress is string
        && data.items is list && data.items.size() > 0 && data.items.size() <= 50
        && data.total is int && data.total > 0
        && data.fulfillment == 'pickup'
        && data.status == 'placed'
        && data.placedAt == request.time
        && data.updatedAt == request.time
        && isValidNewPayment(data);
    }

    // Cash waits for pickup. A card order is saved only after a good payment.
    function isValidNewPayment(data) {
      return (data.paymentMethod == 'cash'
          && data.paymentStatus == 'pending'
          && data.cardBrand == ''
          && data.cardLast4 == '')
        || (data.paymentMethod == 'card'
          && data.paymentStatus == 'paid'
          && data.cardBrand in ['visa', 'mastercard']
          && data.cardLast4 is string
          && data.cardLast4.matches('[0-9]{4}')
          && data.cardLast4 != '0002');
    }

    // Only an open, active restaurant takes orders.
    function canTakeOrders(restaurantId) {
      return exists(/databases/$(database)/documents/restaurants/$(restaurantId))
        && get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.isOpen == true
        && get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.isActive == true;
    }

    // A saved demo card (CUS-9). Any other field, like a full number
    // or a CVV, makes hasOnly fail, so the write is refused.
    function isValidCard(data) {
      return data.keys().hasOnly(['brand', 'last4', 'holderName', 'expMonth', 'expYear', 'isDefault', 'createdAt'])
        && data.keys().hasAll(['brand', 'last4', 'holderName', 'expMonth', 'expYear', 'isDefault', 'createdAt'])
        && data.brand in ['visa', 'mastercard']
        && data.last4 is string && data.last4.matches('[0-9]{4}')
        && data.holderName is string && data.holderName.size() >= 2 && data.holderName.size() <= 60
        && data.expMonth is int && data.expMonth >= 1 && data.expMonth <= 12
        && data.expYear is int && data.expYear >= 2000 && data.expYear <= 2100
        && data.isDefault is bool;
    }

    function isValidMenuItem(data) {
      return data.keys().hasOnly(['name', 'description', 'price', 'imageUrl', 'category', 'available'])
        && data.name is string && data.name.size() > 0
        && data.description is string
        && data.price is int && data.price > 0
        && data.imageUrl is string
        && data.category is string && data.category.size() > 0
        && data.available is bool;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // New users can only create their own profile, as a customer.
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'role', 'createdAt'])
        && request.resource.data.role == 'customer'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time;

      // Users can change only their name and phone. The admin can change anything.
      allow update: if (isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone']))
        || isAdmin();

      allow delete: if false;
    }

    // Only the owner can see or change their cards. Not even the admin.
    match /users/{uid}/cards/{cardId} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && isValidCard(request.resource.data)
        && request.resource.data.createdAt == request.time;

      // Only the default choice can change. The card details stay the same.
      allow update: if isOwner(uid)
        && isValidCard(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isDefault']);

      allow delete: if isOwner(uid);
    }

    match /restaurants/{restaurantId} {
      // The app shows only active restaurants to customers.
      allow read: if isSignedIn();

      // Only the admin creates a restaurant and sets its owner (ADM-5).
      allow create: if isAdmin()
        && isValidRestaurant(request.resource.data)
        && request.resource.data.createdAt == request.time;

      // Admin can change everything except createdAt. The owner can change only isOpen and imageUrl.
      allow update: if isValidRestaurant(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && (isAdmin()
          || (isRestaurantOwner(restaurantId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isOpen', 'imageUrl'])));

      // Turn a restaurant off with isActive instead (ADM-3).
      allow delete: if false;

      match /menuItems/{itemId} {
        allow read: if isSignedIn();

        // Only the restaurant owner manages the menu (RES-3).
        allow create, update: if isRestaurantOwner(restaurantId)
          && isValidMenuItem(request.resource.data);

        allow delete: if isRestaurantOwner(restaurantId);
      }
    }

    match /orders/{orderId} {
      // Customers read only their own orders (CUS-11, My orders).
      // Restaurant and admin reads come with RES-1 and ADM-4.
      allow read: if isSignedIn()
        && resource.data.customerId == request.auth.uid;

      allow create: if isSignedIn()
        && isValidNewOrder(request.resource.data)
        && canTakeOrders(request.resource.data.restaurantId);

      // The customer cancels only a placed order (CUS-6).
      // A paid card order becomes refunded. A cash order stays pending.
      allow update: if isSignedIn()
        && resource.data.customerId == request.auth.uid
        && resource.data.status == 'placed'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paymentStatus', 'updatedAt'])
        && request.resource.data.status == 'cancelled'
        && request.resource.data.updatedAt == request.time
        && ((resource.data.paymentMethod == 'card'
            && resource.data.paymentStatus == 'paid'
            && request.resource.data.paymentStatus == 'refunded')
          || (resource.data.paymentMethod == 'cash'
            && request.resource.data.paymentStatus == resource.data.paymentStatus));

      // Orders are never deleted. They end as completed, rejected, or cancelled.
      allow delete: if false;
    }

    // Other collections stay blocked until we add their rules.
  }
}